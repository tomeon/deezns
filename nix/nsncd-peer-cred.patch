+fn main() {
+    // An executable exports nothing to dlsym(3) unless told to.  NSS modules
+    // loaded into nsncd look this symbol up to learn who they are serving;
+    // see src/peer_cred.rs.
+    println!("cargo:rustc-link-arg-bins=-Wl,--export-dynamic-symbol=nsncd_peer_cred");
+}
