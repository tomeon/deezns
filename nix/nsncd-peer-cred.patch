+//! The credentials of the client whose request a thread is handling.
+//!
+//! nsncd performs every lookup in its own process, so an NSS module that
+//! identifies its caller through `SO_PEERCRED` (or `getuid()`) sees nsncd,
+//! not the process that asked.  To give such modules the real caller, the
+//! worker thread records the client's `SO_PEERCRED` for the duration of the
+//! request and this module exports it as a C function, [`nsncd_peer_cred`],
+//! which an NSS module loaded into nsncd can find with
+//! `dlsym(RTLD_DEFAULT, "nsncd_peer_cred")` and call from the thread doing
+//! the lookup:
+//!
+//! ```c
+//! int (*peer_cred)(struct ucred *) = dlsym(RTLD_DEFAULT, "nsncd_peer_cred");
+//! struct ucred cred;
+//! if (peer_cred != NULL && peer_cred(&cred) == 0) {
+//!     /* cred.pid, cred.uid and cred.gid identify the process that asked */
+//! }
+//! ```
+//!
+//! A null `dlsym` result means the module is not running inside nsncd (or
+//! inside an nsncd without this feature); -1 means the calling thread is not
+//! handling a client request.  The values are what the kernel reported for
+//! the client's connection to nsncd, so they are as trustworthy as nsncd
+//! itself: a module that acts on them is trusting nsncd to relay them
+//! honestly.
+
+use std::cell::Cell;
+use std::os::fd::AsFd;
+
+use nix::libc::{c_int, ucred};
+use nix::sys::socket::{getsockopt, sockopt::PeerCredentials};
+
+thread_local! {
+    static PEER_CRED: Cell<Option<ucred>> = const { Cell::new(None) };
+}
+
+/// Marks the calling thread as handling a request from the client with the
+/// given credentials until dropped.
+pub struct PeerCredGuard {
+    _private: (),
+}
+
+impl PeerCredGuard {
+    pub fn new(cred: ucred) -> Self {
+        PEER_CRED.with(|c| c.set(Some(cred)));
+        PeerCredGuard { _private: () }
+    }
+}
+
+impl Drop for PeerCredGuard {
+    fn drop(&mut self) {
+        PEER_CRED.with(|c| c.set(None));
+    }
+}
+
+/// The credentials of the peer of a connected Unix stream socket, as
+/// recorded by the kernel when the peer connected.
+pub fn of<F: AsFd>(socket: &F) -> nix::Result<ucred> {
+    let cred = getsockopt(socket, PeerCredentials)?;
+    Ok(ucred {
+        pid: cred.pid(),
+        uid: cred.uid(),
+        gid: cred.gid(),
+    })
+}
+
+/// Fills `cred` with the credentials of the client whose request the calling
+/// thread is handling and returns 0.  Returns -1 when the thread is not
+/// handling a request or `cred` is null.
+///
+/// Exported from the nsncd binary for NSS modules; see the module
+/// documentation.
+#[no_mangle]
+pub extern "C" fn nsncd_peer_cred(cred: *mut ucred) -> c_int {
+    if cred.is_null() {
+        return -1;
+    }
+    match PEER_CRED.with(|c| c.get()) {
+        Some(current) => {
+            // SAFETY: the caller promised a valid, writable `struct ucred`.
+            unsafe { cred.write(current) };
+            0
+        }
+        None => -1,
+    }
+}
+
+#[cfg(test)]
+mod test {
+    use super::*;
+
+    use std::os::unix::net::UnixStream;
+    use std::ptr;
+
+    fn empty() -> ucred {
+        ucred {
+            pid: 0,
+            uid: 0,
+            gid: 0,
+        }
+    }
+
+    #[test]
+    fn peer_of_a_socket_pair_is_this_process() {
+        let (ours, _theirs) = UnixStream::pair().unwrap();
+        let cred = of(&ours).unwrap();
+        assert_eq!(cred.pid, std::process::id() as i32);
+        assert_eq!(cred.uid, nix::unistd::geteuid().as_raw());
+        assert_eq!(cred.gid, nix::unistd::getegid().as_raw());
+    }
+
+    #[test]
+    fn accessor_reports_credentials_only_while_the_guard_lives() {
+        let mut out = empty();
+        assert_eq!(nsncd_peer_cred(&mut out), -1);
+        {
+            let _guard = PeerCredGuard::new(ucred {
+                pid: 42,
+                uid: 1000,
+                gid: 100,
+            });
+            assert_eq!(nsncd_peer_cred(&mut out), 0);
+            assert_eq!((out.pid, out.uid, out.gid), (42, 1000, 100));
+            assert_eq!(nsncd_peer_cred(ptr::null_mut()), -1);
+        }
+        assert_eq!(nsncd_peer_cred(&mut out), -1);
+    }
+
+    #[test]
+    fn credentials_are_per_thread() {
+        let _guard = PeerCredGuard::new(ucred {
+            pid: 1,
+            uid: 2,
+            gid: 3,
+        });
+        let other_thread = std::thread::spawn(|| nsncd_peer_cred(&mut empty()))
+            .join()
+            .unwrap();
+        assert_eq!(other_thread, -1);
+        assert_eq!(nsncd_peer_cred(&mut empty()), 0);
+    }
+}
